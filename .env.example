# Copie para .env na raiz do projeto para customizar o docker-compose.
# Nenhum valor sensível está fixo no código; tudo é passado via variáveis de ambiente.

ENVIRONMENT=production
BACKEND_PORT=8000
FRONTEND_PORT=3000

DATABASE_URL=sqlite:///./data/event_management.db
SECRET_KEY=change-this-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000

# URL que o frontend usa para falar com a API (baked no build do Vite)
VITE_API_URL=http://localhost:8000
